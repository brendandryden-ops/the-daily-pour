# Copy to .env.local and fill in. All server-only: never prefix with NEXT_PUBLIC_.
# n8n Cloud Webhook node's Production URL (workflow must be active).
N8N_RESERVATION_WEBHOOK_URL=
# Shared secret, checked by the Webhook node's Header Auth (header: X-Webhook-Secret).
N8N_WEBHOOK_SECRET=

# n8n Chat Trigger URL for the chat bubble. The browser talks to /api/chat, which
# forwards here, so no CORS setup is needed. Leave blank to hide the chat.
N8N_CHAT_WEBHOOK_URL=
