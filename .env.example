# Copy to .env.local and fill in. Keep the reservation keys server-only (no NEXT_PUBLIC_).
# n8n Cloud Webhook node's Production URL (workflow must be active).
N8N_RESERVATION_WEBHOOK_URL=
# Shared secret, checked by the Webhook node's Header Auth (header: X-Webhook-Secret).
N8N_WEBHOOK_SECRET=

# n8n Chat Trigger URL for the chat bubble. Public (sent to the browser), so set
# the Chat Trigger's Allowed Origins to your site. Leave blank to hide the chat.
NEXT_PUBLIC_N8N_CHAT_WEBHOOK_URL=
